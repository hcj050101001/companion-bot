# ONEBOT_SECRET 必填，只允许从进程环境变量读取，禁止写入本文件
# ONEBOT_SECRET=
# 告警 QQ 默认关闭；如需启用请用进程环境变量 ALERT_QQ，勿写入空值到本文件
# ALERT_QQ=
# Gmail SMTP 邮件告警；缺少密码时关闭
ALERT_EMAIL_TO=
# GMAIL_APP_PASSWORD 只允许从启动进程环境变量读取
# DEEPSEEK_API_KEY 禁止写入 .env；只允许从启动进程环境变量读取
# NapCat HTTP API
NAPCAT_BASE_URL=http://127.0.0.1:3000
NAPCAT_QQ=
# 只从进程环境变量读取，不复制到此文件
# DEEPSEEK_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_API_KEY=
